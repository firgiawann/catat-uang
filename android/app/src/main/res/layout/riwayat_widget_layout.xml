<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dynamic Time-Based Background & Weather Illustration -->
    <ImageView
        android:id="@+id/widget_background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <!-- Content Overlay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="Riwayat Terakhir"
                android:textColor="#2D3142"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_see_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Lihat Selengkapnya ›"
                android:textColor="#9C9EB9"
                android:textSize="9sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Empty State Container -->
        <TextView
            android:id="@+id/widget_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Belum ada catatan transaksi 🌸"
            android:textColor="#9C9EB9"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Transactions List Container (Static 3 Rows) -->
        <LinearLayout
            android:id="@+id/widget_list_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Item 1 -->
            <RelativeLayout
                android:id="@+id/widget_item_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_background"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:id="@+id/widget_item_icon_1"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/widget_indicator_green" />

                <TextView
                    android:id="@+id/widget_item_title_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/widget_item_icon_1"
                    android:layout_marginStart="8dp"
                    android:layout_centerVertical="true"
                    android:text="Makan siang"
                    android:textColor="#2D3142"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_item_value_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="+Rp2.654"
                    android:textColor="#2E7D32"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Item 2 -->
            <RelativeLayout
                android:id="@+id/widget_item_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_background"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:id="@+id/widget_item_icon_2"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/widget_indicator_red" />

                <TextView
                    android:id="@+id/widget_item_title_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/widget_item_icon_2"
                    android:layout_marginStart="8dp"
                    android:layout_centerVertical="true"
                    android:text="Makan siang"
                    android:textColor="#2D3142"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_item_value_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="+Rp565.646"
                    android:textColor="#C62828"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Item 3 -->
            <RelativeLayout
                android:id="@+id/widget_item_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_background"
                android:paddingHorizontal="8dp"
                android:paddingVertical="5dp">

                <ImageView
                    android:id="@+id/widget_item_icon_3"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/widget_indicator_green" />

                <TextView
                    android:id="@+id/widget_item_title_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/widget_item_icon_3"
                    android:layout_marginStart="8dp"
                    android:layout_centerVertical="true"
                    android:text="Makan siang"
                    android:textColor="#2D3142"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_item_value_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="+Rp50.000"
                    android:textColor="#2E7D32"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </RelativeLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
